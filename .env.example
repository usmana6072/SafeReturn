SAFERETURN_READINESS_TOKEN=
SAFERETURN_API_ORIGIN=
SAFERETURN_DATABASE_URL=
SAFERETURN_MIGRATION_DATABASE_URL=
SAFERETURN_WORKER_DATABASE_URL=
SAFERETURN_TEST_DATABASE_URL=
SAFERETURN_SUPABASE_URL=
SAFERETURN_SUPABASE_PUBLISHABLE_KEY=
SAFERETURN_WEB_ORIGIN=
SAFERETURN_SESSION_SIGNING_KEY=
# Server-only, independent 256-bit HMAC key encoded as base64url; use version 1 initially.
SAFERETURN_ACTIVATION_VERIFIER_KEY=
SAFERETURN_ACTIVATION_VERIFIER_KEY_VERSION=1
# Printer-held RSA public key (PEM, at least 3072 bits); the matching private key stays outside SafeReturn.
SAFERETURN_PRINT_RECIPIENT_PUBLIC_KEY=
# Server-only independent data keys: JSON mapping version strings to base64url 32-byte keys.
# Leave unset until a real key is supplied. Dummy keys belong only in isolated tests.
SAFERETURN_PROFILE_DATA_KEYS=
SAFERETURN_PROFILE_DATA_KEY_VERSION=1


# Task 4.2: backend secret/expected public hostname; public widget sitekey in frontend.
SAFERETURN_TURNSTILE_SECRET_KEY=
SAFERETURN_TURNSTILE_EXPECTED_HOSTNAME=
NEXT_PUBLIC_SAFERETURN_TURNSTILE_SITE_KEY=

# Task 4.4: server-only notification worker; never expose the key to the frontend.
SAFERETURN_RESEND_API_KEY=
SAFERETURN_NOTIFICATION_FROM_EMAIL=
SAFERETURN_NOTIFICATION_WORKER_ID=safereturn-notification-worker
SAFERETURN_NOTIFICATION_LEASE_SECONDS=60
SAFERETURN_NOTIFICATION_MAX_ATTEMPTS=8
SAFERETURN_NOTIFICATION_HTTP_TIMEOUT_SECONDS=10

# Task 5.1: server-only verified public marketing media. Leave unset until configured.
# SAFERETURN_CLOUDINARY_CLOUD_NAME=
# SAFERETURN_CLOUDINARY_API_KEY=
# SAFERETURN_CLOUDINARY_API_SECRET=
SAFERETURN_CLOUDINARY_PUBLIC_FOLDER=safereturn/catalog/
# Signed public raster preset; app checks 5 MB before upload and attachment.
# SAFERETURN_CLOUDINARY_UPLOAD_PRESET=
# JSON list of approved template_key@version values; empty blocks publishing.
SAFERETURN_CATALOG_APPROVED_TEMPLATES=[]

# Task 5.2 remains disabled until approved pricing/physical configuration exists.
SAFERETURN_CHECKOUT_ENABLED=false
# Approved flat shipping/tax amounts as decimal strings; do not assume free shipping.
# SAFERETURN_CHECKOUT_SHIPPING_PKR=
# SAFERETURN_CHECKOUT_TAX_PKR=
SAFERETURN_CHECKOUT_RESERVATION_MINUTES=30
SAFERETURN_CHECKOUT_EXISTING_QR_REUSE_ENABLED=false

# Task 5.3 server-only private evidence and stable keyed settlement deduplication.
SAFERETURN_SUPABASE_STORAGE_SERVICE_KEY=
SAFERETURN_PAYMENT_REFERENCE_KEY=

# Private PDF renderer: disabled unless approved immutable template bundle is configured.
SAFERETURN_PRINT_ENABLED=
SAFERETURN_PRINT_TEMPLATE_BUNDLE_PATH=
SAFERETURN_PRINT_TEMPLATE_BUNDLE_SHA256=
SAFERETURN_PRINT_WORKER_ID=
SAFERETURN_PRINT_LEASE_SECONDS=
SAFERETURN_PRINT_MAX_ATTEMPTS=


# Task 5.6: server-only mirror; actual sheet/tab/columns/sharing need documented approval.
SAFERETURN_GOOGLE_SHEETS_APPROVED=false
# SAFERETURN_GOOGLE_SHEETS_SPREADSHEET_ID=
# SAFERETURN_GOOGLE_SHEETS_TAB=
# SAFERETURN_GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
SAFERETURN_FINANCE_WORKER_ID=safereturn-finance-worker
SAFERETURN_FINANCE_LEASE_SECONDS=60
SAFERETURN_FINANCE_MAX_ATTEMPTS=5
# Independent approved policy references; unset blocks deletion even with a past cutoff.
# SAFERETURN_PRINT_RETENTION_APPROVAL=
# SAFERETURN_EVIDENCE_RETENTION_APPROVAL=
SAFERETURN_RETENTION_WORKER_ID=safereturn-retention-worker
SAFERETURN_RETENTION_LEASE_SECONDS=60
SAFERETURN_RETENTION_MAX_ATTEMPTS=5
